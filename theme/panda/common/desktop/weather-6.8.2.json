  "settings_policy": "no-overrides-unconfigured-only",
  "native_geometry": {
    "full_minimum_width": "min(25 gridUnits, max(10 gridUnits, implicitWidth))",
    "full_minimum_height": "max(10 gridUnits, implicitHeight)",
    "compact_minimum": "representation-dependent icon/text implicit sizes"
  },
  "reviewed_provider": {
    "id": "noaa",
    "namespace": "plasma/weather_ions",
    "selection": null,
    "coverage": "NWS-supported US stations and forecast grid only; not a worldwide fallback",
    "station_search": "bundled plasma/weather/noaa_station_list.xml; no network for NOAA-only matching",
    "secret_key_required": false,
    "authentication_caveat": "NWS requires application User-Agent and announces a possible future API key; revalidate before use",
    "request_templates": [
      "https://api.weather.gov/stations/{stationID}/observations/latest",
      "https://api.weather.gov/points/{stationLatitude},{stationLongitude}",
      "forecast URL supplied by points response, normally https://api.weather.gov/gridpoints/{office}/{x},{y}/forecast",
      "https://api.weather.gov/alerts/active?zone={countyID}"
    ],
    "network_caveats": [
      "KIO::get Reload; redirects and server-provided forecast URL are not host-restricted in this reviewed adapter",
      "generic KDE location search fans out to eligible providers; NOAA-only review does not authorize that search UI",
      "configured location starts fetching immediately; updateInterval=0 only stops periodic timer"
    ],
    "credit": "Data from NOAA National Weather Service",
    "source_temperature_unit": "Fahrenheit",
    "cache_policy": "KDE ForecastData shared in-memory by provider/place; no Panda cache, persistence or credentials; KIO cache behavior not attested"
  },
