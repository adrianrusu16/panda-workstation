{
  "native_geometry": {
    "faces_minimum_width_grid_units": 8,
    "linechart_plot_minimum_height_grid_units": 3,
    "planar_representation": "full; switchWidth/switchHeight return -1 on desktop",
    "whole_widget_minimum_height": null,
    "whole_widget_size": "dynamic title/legend/font/content metrics plus wrapper padding"
  },
  "native_limits": [
    "horizontalbars Bar.qml falls back to zero for null sensor value; unknown/stale display fidelity is not established",
    "PercentageSensor returns zero when base maximum is not positive; the synthetic projection instead requires a valid positive denominator",
    "linechart HistoryProxySource samples by interval with FillFromEnd; synthetic null gap segmentation is not proof of native gap handling",
    "one second updateRateLimit is a requested throttle, not a provider freshness guarantee",
    "default/configurable background is inherited; opaque rendering requires native visual verification"
  ],
  "packages": [
    "plasma-workspace",
    "libksysguard",
    "ksystemstats"
  ],
  "plasma_version": "6.8.2",
  "plugins": {
    "cpu": "org.kde.plasma.systemmonitor.cpu",
    "ram": "org.kde.plasma.systemmonitor.memory"
  },
  "provider": {
    "activation": "face/controller/sensor construction may resolve/subscribe/start service",
    "connection": "session bus; never contacted offline",
    "interface": "org.kde.ksystemstats1",
    "path": "/org/kde/ksystemstats1",
    "service": "org.kde.ksystemstats1"
  },
  "schema_version": 1,
  "scope": "panda-reviewed-system-source-contract",
  "sensors": {
    "cpu/all/usage": {
      "meaning": "aggregate system+user tick delta / aggregate total tick delta; iowait excluded from busy numerator",
      "range": [
        0,
        100
      ],
      "unit": "percent"
    },
    "memory/physical/free": {
      "meaning": "Linux MemAvailable, not raw MemFree",
      "unit": "byte"
    },
    "memory/physical/total": {
      "meaning": "Linux MemTotal",
      "unit": "byte"
    },
    "memory/physical/used": {
      "meaning": "Linux MemTotal minus MemAvailable",
      "unit": "byte"
    },
    "memory/physical/usedPercent": {
      "meaning": "used / total * 100; synthetic model requires valid synchronized positive total",
      "unit": "percent"
    }
  },
  "settings": {
    "cpu": {
      "Appearance/chartFace": "org.kde.ksysguard.linechart",
      "Appearance/showTitle": true,
      "Appearance/title": "CPU",
      "Appearance/updateRateLimit": 1000,
      "Sensors/highPrioritySensorIds": [
        "cpu/all/usage"
      ],
      "Sensors/lowPrioritySensorIds": [],
      "Sensors/totalSensors": [
        "cpu/all/usage"
      ],
      "org.kde.ksysguard.linechart/General/historyAmount": 60,
      "org.kde.ksysguard.linechart/General/lineChartSmooth": false,
      "org.kde.ksysguard.linechart/General/rangeAutoY": false,
      "org.kde.ksysguard.linechart/General/rangeFromY": 0.0,
      "org.kde.ksysguard.linechart/General/rangeToY": 100.0
    },
    "ram": {
      "Appearance/chartFace": "org.kde.ksysguard.horizontalbars",
      "Appearance/showTitle": true,
      "Appearance/title": "Memory",
      "Appearance/updateRateLimit": 1000,
      "Sensors/highPrioritySensorIds": [
        "memory/physical/used"
      ],
      "Sensors/lowPrioritySensorIds": [
        "memory/physical/free",
        "memory/physical/total"
      ],
      "Sensors/totalSensors": [
        "memory/physical/usedPercent"
      ],
      "org.kde.ksysguard.horizontalbars/General/rangeAuto": true
    }
  },
