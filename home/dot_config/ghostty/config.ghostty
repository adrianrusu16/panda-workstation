# 🐼 Panda Workstation — Ghostty trial profile
# Deliberately mirrors Kitty's font, palette, padding, and shell so the comparison is about terminal behavior.

font-family = JetBrainsMono Nerd Font Mono
font-size = 11.5
font-feature = +calt
font-feature = +liga

window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
window-decoration = auto
window-save-state = always

shell-integration = fish
cursor-style = bar
cursor-style-blink = false

background = #0b0f14
foreground = #d8dee9
cursor-color = #7ee787
selection-background = #263342
selection-foreground = #ffffff

palette = 0=#0b0f14
palette = 1=#ff7b72
palette = 2=#7ee787
palette = 3=#d29922
palette = 4=#58a6ff
palette = 5=#bc8cff
palette = 6=#39c5cf
palette = 7=#d8dee9
palette = 8=#586069
palette = 9=#ffa198
palette = 10=#aff5b4
palette = 11=#e3b341
palette = 12=#79c0ff
palette = 13=#d2a8ff
palette = 14=#56d4dd
palette = 15=#ffffff

# Shared trial shortcuts
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+enter=new_split:auto
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+up=goto_split:up
keybind = ctrl+shift+down=goto_split:down

# Font controls
keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1
keybind = ctrl+shift+0=reset_font_size
